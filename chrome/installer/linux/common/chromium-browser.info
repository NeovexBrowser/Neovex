# This file provides common configuration information for building
# rhenium-browser packages for various platforms.

# Base name of the package.
PACKAGE="rhenium-browser"

# Filename of the main executable (for generating launcher scripts, etc.)
PROGNAME=rhenium

# Base directory for package installation.
INSTALLDIR=/opt/rhenium

# Directory for device policy enrollments.
ENROLLMENTDIR=/etc/rhenium/policies/enrollment

# Display string for desktop menu/icon.
MENUNAME="Rhenium"

# Brief package description.
SHORTDESC="The Rhenium web browser"

# Detailed package description.
FULLDESC="Rhenium is a browser that combines a minimal design with sophisticated technology to make the web faster, safer, and easier."

# Package maintainer information.
MAINTNAME="Rhenium Linux Team"
MAINTMAIL="rheniumbrowser@gmail.com"
PRODUCTURL="https://github.com/RheniumBrowser/Rhenium"

PROJECT_LICENSE="BSD-3-Clause and LGPL-2.1+ and Apache-2.0 and IJG and MIT and GPL-2.0+ and ISC and OpenSSL and (MPL-1.1 or GPL-2.0 or LGPL-2.0)"

DEVELOPER_NAME="Rhenium Team"

BUGTRACKERURL="https://github.com/RheniumBrowser/Rhenium/issues"

HELPURL="https://github.com/RheniumBrowser/Rhenium"
RDN="org.rhenium.Rhenium"
